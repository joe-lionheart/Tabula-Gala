# Kopieren nach .env und ausfüllen. Ohne Schlüssel läuft der Übungsmodus.
ANTHROPIC_API_KEY=
TISCHLEITER_MODEL=claude-sonnet-5-5
# Höchstens so viele Tokens pro Runde, dann übernimmt der Host
TISCHLEITER_TOKEN_DECKEL=2000000
# Denktiefe des Moderators: low (schnell, Standard), medium, high
TISCHLEITER_EFFORT=low
PORT=3000
